# Abandoned Dunes iOS pipeline. Same approach as Blackspire (gorillastocks/blackspire):
# GitHub Actions macOS runner + fastlane, App Store Connect API key, one persistent Apple Distribution certificate
# (imported from secrets), App Store profile created/renewed through the API key. Nothing is ever revoked.
default_platform(:ios)

BUNDLE_ID = "com.gorillastocks.abandoneddunes"
APP_NAME = "Abandoned Dunes"
IAP_PRODUCT_ID = "com.gorillastocks.abandoneddunes.fullgame"
MARKETING_VERSION = "1.0"
PROFILE_NAME = "Abandoned Dunes AppStore CI"
DIST_TYPES = %w[IOS_DISTRIBUTION DISTRIBUTION].freeze

def asc_api_key
  app_store_connect_api_key(
    key_id: ENV.fetch("ASC_KEY_ID"),
    issuer_id: ENV.fetch("ASC_ISSUER_ID"),
    key_content: ENV.fetch("ASC_KEY_P8"),
    in_house: false
  )
end

def list_dist_certs
  Spaceship::ConnectAPI::Certificate.all(filter: { certificateType: DIST_TYPES.join(",") })
end

# Direct App Store Connect REST call (v1) with the JWT fastlane built from the API key (spaceship's tunes client
# used the wrong base path for Game Center resources: "path does not match a defined resource type").
def asc_call(verb, path, body = nil, query = nil)
  require "net/http"
  require "json"
  uri = URI(path.start_with?("v2/") ? "https://api.appstoreconnect.apple.com/#{path}" : "https://api.appstoreconnect.apple.com/v1/#{path}")
  uri.query = URI.encode_www_form(query) if query
  klass = { get: Net::HTTP::Get, post: Net::HTTP::Post, patch: Net::HTTP::Patch, delete: Net::HTTP::Delete }.fetch(verb)
  req = klass.new(uri)
  req["Authorization"] = "Bearer #{Spaceship::ConnectAPI.token.text}"
  req["Content-Type"] = "application/json"
  req.body = JSON.generate(body) if body
  res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
  parsed = begin
    res.body.to_s.empty? ? {} : JSON.parse(res.body)
  rescue StandardError
    { "raw" => res.body.to_s[0, 300] }
  end
  unless res.code.to_i.between?(200, 299)
    detail = (parsed["errors"] || []).map { |x| "#{x['code']} #{x['title']} #{x['detail']}" }.join("; ")
    raise "HTTP #{res.code} #{verb.to_s.upcase} #{path}: #{detail.empty? ? parsed.to_s[0, 300] : detail}"
  end
  parsed
end

platform :ios do
  desc "Read-only: list distribution certs, bundle id + capabilities, the App Store Connect app record and recent builds"
  lane :info do
    asc_api_key
    list_dist_certs.each do |c|
      UI.message("dist cert id=#{c.id} type=#{c.certificate_type} serial=#{c.serial_number} expires=#{c.expiration_date}")
    end
    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    if bundle.nil?
      UI.important("Bundle ID #{BUNDLE_ID} is NOT registered yet (run the 'register' action)")
    else
      UI.message("Bundle ID #{BUNDLE_ID} registered, seed/team=#{bundle.seed_id}")
      UI.message("App ID capabilities: #{bundle.get_capabilities.map(&:capability_type).join(', ')}")
    end
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    if app.nil?
      UI.important("No App Store Connect app record for #{BUNDLE_ID} yet (it must be created once in the App Store Connect UI: Apps > + > New App)")
    else
      UI.message("ASC app: #{app.name} id=#{app.id} sku=#{app.sku}")
      app.get_builds(limit: 5, sort: "-uploadedDate").each do |b|
        UI.message("build #{b.version} uploaded=#{b.uploaded_date} processing=#{b.processing_state} expired=#{b.expired}")
      end
    end
  end

  desc "Register the bundle id (explicit) and enable the Game Center capability. Idempotent; creates nothing else."
  lane :register do
    asc_api_key
    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    if bundle.nil?
      bundle = Spaceship::ConnectAPI::BundleId.create(name: APP_NAME, platform: "IOS", identifier: BUNDLE_ID)
      UI.success("Registered #{BUNDLE_ID} (id=#{bundle.id})")
    else
      UI.message("Bundle ID already registered (id=#{bundle.id})")
    end
    caps = bundle.get_capabilities.map(&:capability_type)
    unless caps.include?("GAME_CENTER")
      bundle.create_capability(Spaceship::ConnectAPI::BundleIdCapability::Type::GAME_CENTER)
      UI.success("Enabled GAME_CENTER capability")
    end
    UI.message("Capabilities now: #{bundle.get_capabilities.map(&:capability_type).join(', ')}")
  end

  desc "Compile the iOS app (incl. the Swift Game Center plugin) without signing. Needs no secrets."
  lane :compile_check do
    sh("cd #{File.expand_path('..', __dir__)} && xcodebuild -project ios/App/App.xcodeproj -scheme App -configuration Release " \
       "-destination 'generic/platform=iOS' -derivedDataPath ios/DerivedData " \
       "CODE_SIGNING_ALLOWED=NO CODE_SIGNING_REQUIRED=NO CODE_SIGN_IDENTITY='' build")
  end


  desc "Create/refresh the 'All Courses' non-consumable IAP (metadata, availability, $2.99 base price, review screenshot). Never submits anything."
  lane :iap do
    require "digest"
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No App Store Connect app record for #{BUNDLE_ID}") if app.nil?
    pid = IAP_PRODUCT_ID
    existing = asc_call(:get, "apps/#{app.id}/inAppPurchasesV2", nil, { "filter[productId]" => pid, "limit" => 10 })["data"] || []
    if existing.empty?
      iap = asc_call(:post, "v2/inAppPurchases", { data: { type: "inAppPurchases",
        attributes: { name: "All Courses", productId: pid, inAppPurchaseType: "NON_CONSUMABLE", familySharable: false,
                      reviewNote: "Non-consumable that unlocks all 7 courses and holes 6-18 of Terrific Dunes. The free tier is Terrific Dunes holes 1-5 (no sign-in or account needed). To test: Play a Round > tap any locked course, or finish the 5 free holes, and tap Unlock." },
        relationships: { app: { data: { type: "apps", id: app.id } } } } })["data"]
      UI.message("Created IAP #{iap['id']}")
    else
      iap = existing.first
      UI.message("IAP exists: #{iap['id']} state=#{iap['attributes']['state']}")
    end
    iap_id = iap["id"]

    # en-US localization
    locs = asc_call(:get, "v2/inAppPurchases/#{iap_id}/inAppPurchaseLocalizations")["data"] || []
    if locs.none? { |l| l["attributes"]["locale"] == "en-US" }
      asc_call(:post, "inAppPurchaseLocalizations", { data: { type: "inAppPurchaseLocalizations",
        attributes: { locale: "en-US", name: "All Courses", description: "Unlock all 7 courses, every hole" },
        relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: iap_id } } } } })
      UI.message("Added en-US localization")
    end

    # availability: every territory, including new ones
    begin
      av = asc_call(:get, "v2/inAppPurchases/#{iap_id}/inAppPurchaseAvailability")
      raise "none" if av["data"].nil?
      UI.message("Availability already set")
    rescue StandardError
      terrs = []
      url_q = { "limit" => 200 }
      terrs = asc_call(:get, "territories", nil, url_q)["data"].map { |t| t["id"] }
      asc_call(:post, "inAppPurchaseAvailabilities", { data: { type: "inAppPurchaseAvailabilities",
        attributes: { availableInNewTerritories: true },
        relationships: { inAppPurchase: { data: { type: "inAppPurchases", id: iap_id } },
                         availableTerritories: { data: terrs.map { |t| { type: "territories", id: t } } } } } })
      UI.message("Availability set for #{terrs.size} territories")
    end

    # base price $2.99 USD (other territories auto-equalized from the USA base)
    has_schedule = begin
      sch = asc_call(:get, "v2/inAppPurchases/#{iap_id}/iapPriceSchedule")["data"]
      sch.nil? ? false : asc_call(:get, "inAppPurchasePriceSchedules/#{sch['id']}/manualPrices", nil, { "limit" => 50 })["data"].to_a.any?
    rescue StandardError
      false
    end
    if has_schedule
      UI.message("Price schedule already exists; leaving as is")
    else
      pp = nil
      cursor = nil
      loop do
        q = { "filter[territory]" => "USA", "limit" => 200 }
        q["cursor"] = cursor if cursor
        r = asc_call(:get, "v2/inAppPurchases/#{iap_id}/pricePoints", nil, q)
        pp = (r["data"] || []).find { |x| x["attributes"]["customerPrice"].to_f == 2.99 }
        break if pp || r.dig("links", "next").nil?
        cursor = URI.decode_www_form(URI(r["links"]["next"]).query).to_h["cursor"]
        break if cursor.nil?
      end
      UI.user_error!("No $2.99 USA price point found") if pp.nil?
      asc_call(:post, "inAppPurchasePriceSchedules", {
        data: { type: "inAppPurchasePriceSchedules", relationships: {
          inAppPurchase: { data: { type: "inAppPurchases", id: iap_id } },
          baseTerritory: { data: { type: "territories", id: "USA" } },
          manualPrices: { data: [{ type: "inAppPurchasePrices", id: "${price1}" }] } } },
        included: [{ type: "inAppPurchasePrices", id: "${price1}", attributes: { startDate: nil },
                     relationships: { inAppPurchasePricePoint: { data: { type: "inAppPurchasePricePoints", id: pp["id"] } } } }]
      })
      UI.message("Base price set: USA $2.99")
    end

    # review screenshot (paywall)
    shot = begin
      asc_call(:get, "v2/inAppPurchases/#{iap_id}/appStoreReviewScreenshot")["data"]
    rescue StandardError
      nil
    end
    if shot.nil?
      path = File.expand_path("../store/iap/paywall-1320x2868.png", __dir__)
      bytes = File.binread(path)
      created = asc_call(:post, "inAppPurchaseAppStoreReviewScreenshots", { data: { type: "inAppPurchaseAppStoreReviewScreenshots",
        attributes: { fileName: "paywall.png", fileSize: bytes.bytesize },
        relationships: { inAppPurchaseV2: { data: { type: "inAppPurchases", id: iap_id } } } } })["data"]
      (created["attributes"]["uploadOperations"] || []).each do |op|
        uri = URI(op["url"])
        req = Net::HTTP::Put.new(uri)
        (op["requestHeaders"] || []).each { |h| req[h["name"]] = h["value"] }
        req.body = bytes.byteslice(op["offset"], op["length"])
        res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |h| h.request(req) }
        UI.user_error!("Screenshot chunk upload failed: HTTP #{res.code}") unless res.code.to_i.between?(200, 299)
      end
      asc_call(:patch, "inAppPurchaseAppStoreReviewScreenshots/#{created['id']}", { data: { type: "inAppPurchaseAppStoreReviewScreenshots", id: created["id"],
        attributes: { uploaded: true, sourceFileChecksum: Digest::MD5.hexdigest(bytes) } } })
      UI.message("Review screenshot uploaded")
    else
      UI.message("Review screenshot already present")
    end

    final = asc_call(:get, "v2/inAppPurchases/#{iap_id}")["data"]["attributes"]
    UI.message("IAP #{final['productId']} name=#{final['name']} type=#{final['inAppPurchaseType']} state=#{final['state']}")
    sch2 = asc_call(:get, "v2/inAppPurchases/#{iap_id}/iapPriceSchedule")["data"] rescue nil
    if sch2
      mp = asc_call(:get, "inAppPurchasePriceSchedules/#{sch2['id']}/manualPrices", nil, { "limit" => 10 })["data"].to_a
      UI.message("Manual prices scheduled: #{mp.size}")
    end
  end

  desc "Build with the persistent distribution cert and upload to TestFlight"
  lane :beta do
    api_key = asc_api_key
    bundle = Spaceship::ConnectAPI::BundleId.find(BUNDLE_ID)
    UI.user_error!("Bundle ID #{BUNDLE_ID} not found; run the 'register' action first") if bundle.nil?
    team_id = ENV["TEAM_ID"] || bundle.seed_id
    UI.user_error!("No App Store Connect app record for #{BUNDLE_ID}; create it once in App Store Connect (Apps > + > New App)") if Spaceship::ConnectAPI::App.find(BUNDLE_ID).nil?

    build_number = latest_testflight_build_number(
      app_identifier: BUNDLE_ID,
      api_key: api_key,
      initial_build_number: 0
    ) + 1
    UI.message("Marketing version #{MARKETING_VERSION}, build #{build_number}")

    UI.user_error!("ios/App/App/public/vendor/bundle exists (Ruby gems leaked into the web bundle); rerun ios:sync") if Dir.exist?(File.expand_path("../ios/App/App/public/vendor/bundle", __dir__))
    setup_ci
    keychain_path = File.expand_path("~/Library/Keychains/#{ENV['MATCH_KEYCHAIN_NAME']}-db")
    p12_path = File.join(Dir.mktmpdir("cert"), "dist.p12")
    File.binwrite(p12_path, Base64.decode64(ENV.fetch("DIST_CERT_P12")))
    import_certificate(
      certificate_path: p12_path,
      certificate_password: ENV.fetch("DIST_CERT_PASSWORD"),
      keychain_path: keychain_path,
      keychain_password: ""
    )
    File.delete(p12_path)
    %w[AppleWWDRCAG3 AppleWWDRCAG6].each do |ca|
      sh("curl -fsSL https://www.apple.com/certificateauthority/#{ca}.cer -o /tmp/#{ca}.cer && security import /tmp/#{ca}.cer -k '#{keychain_path}' -T /usr/bin/codesign || true")
    end

    sigh(
      api_key: api_key,
      app_identifier: BUNDLE_ID,
      team_id: team_id,
      provisioning_name: PROFILE_NAME,
      force: false
    )

    update_code_signing_settings(
      use_automatic_signing: false,
      path: "ios/App/App.xcodeproj",
      team_id: team_id,
      targets: ["App"],
      build_configurations: ["Release"],
      code_sign_identity: "Apple Distribution",
      profile_name: PROFILE_NAME,
      bundle_identifier: BUNDLE_ID
    )

    build_app(
      project: "ios/App/App.xcodeproj",
      scheme: "App",
      configuration: "Release",
      destination: "generic/platform=iOS",
      export_method: "app-store",
      output_directory: "ios/App/output",
      output_name: "AbandonedDunes.ipa",
      clean: true,
      xcargs: "MARKETING_VERSION=#{MARKETING_VERSION} CURRENT_PROJECT_VERSION=#{build_number}",
      export_options: {
        method: "app-store",
        signingStyle: "manual",
        teamID: team_id,
        provisioningProfiles: { BUNDLE_ID => PROFILE_NAME },
        uploadSymbols: true,
        manageAppVersionAndBuildNumber: false
      }
    )

    # fastlane's upload_to_testflight read a bundle id of $(PRODUCT_BUNDLE_IDENTIFIER) from a nested Info.plist in the ipa
    # (the app has dynamic Capacitor/Cordova frameworks), so verify the real app plist and call altool with explicit values.
    ipa = File.expand_path("../ios/App/output/AbandonedDunes.ipa", __dir__)
    x = Dir.mktmpdir("ipax")
    sh("unzip -o -q '#{ipa}' 'Payload/App.app/Info.plist' -d '#{x}'")
    plist = File.join(x, "Payload/App.app/Info.plist")
    ipa_bundle = sh("plutil -extract CFBundleIdentifier raw -o - '#{plist}'", log: false).strip
    ipa_build = sh("plutil -extract CFBundleVersion raw -o - '#{plist}'", log: false).strip
    ipa_ver = sh("plutil -extract CFBundleShortVersionString raw -o - '#{plist}'", log: false).strip
    UI.message("ipa app plist: bundle=#{ipa_bundle} version=#{ipa_ver} build=#{ipa_build}")
    UI.user_error!("ipa bundle id #{ipa_bundle} != #{BUNDLE_ID}") unless ipa_bundle == BUNDLE_ID
    UI.user_error!("ipa build #{ipa_build} != #{build_number}") unless ipa_build == build_number.to_s

    key_dir = File.expand_path("~/.appstoreconnect/private_keys")
    FileUtils.mkdir_p(key_dir)
    File.write(File.join(key_dir, "AuthKey_#{ENV.fetch('ASC_KEY_ID')}.p8"), ENV.fetch("ASC_KEY_P8"))
    asc_app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    sh("xcrun altool --upload-package '#{ipa}' --type ios --apple-id #{asc_app.id} --bundle-id #{BUNDLE_ID} " \
       "--bundle-version #{build_number} --bundle-short-version-string #{ipa_ver} " \
       "--apiKey #{ENV.fetch('ASC_KEY_ID')} --apiIssuer #{ENV.fetch('ASC_ISSUER_ID')}")
    UI.success("Uploaded build #{build_number}; waiting for App Store Connect processing")

    state = nil
    60.times do
      b = asc_app.get_builds(limit: 10, sort: "-uploadedDate").find { |x2| x2.version.to_s == build_number.to_s }
      state = b&.processing_state
      UI.message("build #{build_number} processing_state=#{state.inspect}")
      break if %w[VALID FAILED INVALID].include?(state.to_s)
      sleep 60
    end
    UI.important("FINAL build #{build_number} processing_state=#{state.inspect}")
    UI.user_error!("TestFlight processing ended as #{state.inspect}") if %w[FAILED INVALID].include?(state.to_s)

    sh("echo \"build_number=#{build_number}\" >> \"$GITHUB_OUTPUT\"") if ENV["GITHUB_OUTPUT"]
  end
  # ---------------------------------------------------------------------------------------------
  # gamecenter: creates the 21 leaderboards + 4 achievements through the App Store Connect API (idempotent).
  # Needs the ASC app record to exist (it can only be created in the App Store Connect web UI).
  # Mirrors docs/APP_STORE.md section 2.
  # ---------------------------------------------------------------------------------------------
  desc "Create Game Center leaderboards and achievements via the ASC API (idempotent)"
  lane :gamecenter do
    require "digest"
    require "net/http"
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No App Store Connect app record for #{BUNDLE_ID} yet. Create it once in the App Store Connect UI.") if app.nil?

    errmsg = lambda { |e| "#{e.class}: #{e.message.to_s[0, 1200]}" }
    detail_id = nil
    begin
      detail_id = asc_call(:get, "apps/#{app.id}/gameCenterDetail").dig("data", "id")
    rescue StandardError => e
      UI.important("GET apps/<id>/gameCenterDetail failed: #{errmsg.call(e)}")
    end
    if detail_id.nil?
      begin
        inc = asc_call(:get, "apps/#{app.id}", nil, { include: "gameCenterDetail" })
        detail_id = (inc["included"] || []).find { |d| d["type"] == "gameCenterDetails" }&.dig("id")
        detail_id ||= inc.dig("data", "relationships", "gameCenterDetail", "data", "id")
        UI.important("detail via include: #{detail_id.inspect}")
      rescue StandardError => e
        UI.important("GET apps/<id>?include=gameCenterDetail failed: #{errmsg.call(e)}")
      end
    end
    if detail_id.nil?
      begin
        detail_id = asc_call(:post, "gameCenterDetails", { data: { type: "gameCenterDetails", relationships: { app: { data: { type: "apps", id: app.id } } } } }).dig("data", "id")
        UI.success("Enabled Game Center for the app (detail #{detail_id})")
      rescue StandardError => e
        UI.user_error!("POST gameCenterDetails failed: #{errmsg.call(e)}")
      end
    end
    UI.message("gameCenterDetail id=#{detail_id}")

    failures = []
    existing_lb = {}
    asc_call(:get, "gameCenterDetails/#{detail_id}/gameCenterLeaderboards", nil, { limit: 200 })["data"].to_a.each { |d| existing_lb[d.dig("attributes", "vendorIdentifier")] = d["id"] }
    existing_ach = {}
    asc_call(:get, "gameCenterDetails/#{detail_id}/gameCenterAchievements", nil, { limit: 200 })["data"].to_a.each { |d| existing_ach[d.dig("attributes", "vendorIdentifier")] = d["id"] }

    courses = [
      ["bandit", "Bandit Dunes"], ["terrific", "Terrific Dunes"], ["abandon", "Abandon Trails"],
      ["oldmac", "Old MacDonald Had a Links"], ["sheepwreck", "Sheep Wreck"], ["preserveus", "Preserve Us!"], ["shortcircuit", "Short Circuit"]
    ]
    diffs = [["simple", "Simple"], ["normal", "Normal"], ["realistic", "Realistic"]]
    courses.each do |slug, cname|
      diffs.each do |dslug, dname|
        vid = "abandoneddunes.lb.#{slug}.#{dslug}"
        name = "#{cname} \u2014 #{dname}" # Game Center localized names are limited to 30 characters
        begin
          lb_id = existing_lb[vid]
          if lb_id.nil?
            lb = asc_call(:post, "gameCenterLeaderboards", { data: { type: "gameCenterLeaderboards",
              attributes: { defaultFormatter: "INTEGER", referenceName: name, vendorIdentifier: vid, submissionType: "BEST_SCORE", scoreSortType: "ASC", scoreRangeStart: "1", scoreRangeEnd: "500" },
              relationships: { gameCenterDetail: { data: { type: "gameCenterDetails", id: detail_id } } } } })
            lb_id = lb.dig("data", "id")
            UI.success("created leaderboard #{vid}")
          end
          locs = asc_call(:get, "gameCenterLeaderboards/#{lb_id}/localizations")["data"].to_a
          if locs.empty?
            asc_call(:post, "gameCenterLeaderboardLocalizations", { data: { type: "gameCenterLeaderboardLocalizations",
              attributes: { locale: "en-US", name: name, formatterSuffix: "strokes", formatterSuffixSingular: "stroke" },
              relationships: { gameCenterLeaderboard: { data: { type: "gameCenterLeaderboards", id: lb_id } } } } })
            UI.success("added localization #{vid}")
          else
            UI.message("leaderboard complete: #{vid}")
          end
        rescue StandardError => e
          failures << "#{vid}: #{e.message.to_s[0, 400]}"
          UI.error("FAILED #{vid}: #{e.message.to_s[0, 400]}")
        end
      end
    end

    achievements = [
      ["firstbirdie", "First Birdie", 10, "Make a birdie (1 under par) on any hole.", "You made your first birdie!"],
      ["eagle", "Eagle Eye", 25, "Make an eagle (2 under par) on any hole.", "You made an eagle!"],
      ["holeinone", "Hole in One", 50, "Hole out in a single stroke.", "Ace! You made a hole in one!"],
      ["breakpar", "Par Breaker", 25, "Finish a complete course under par.", "You finished a full course under par!"]
    ]
    achievements.each do |slug, title, points, before, after|
      vid = "abandoneddunes.ach.#{slug}"
      begin
        a_id = existing_ach[vid]
        if a_id.nil?
          a_id = asc_call(:post, "gameCenterAchievements", { data: { type: "gameCenterAchievements",
            attributes: { referenceName: title, vendorIdentifier: vid, points: points, showBeforeEarned: true, repeatable: false },
            relationships: { gameCenterDetail: { data: { type: "gameCenterDetails", id: detail_id } } } } }).dig("data", "id")
          UI.success("created achievement #{vid}")
        end
        loc = asc_call(:get, "gameCenterAchievements/#{a_id}/localizations")["data"].to_a.first
        if loc.nil?
          loc = asc_call(:post, "gameCenterAchievementLocalizations", { data: { type: "gameCenterAchievementLocalizations",
            attributes: { locale: "en-US", name: title, beforeEarnedDescription: before, afterEarnedDescription: after },
            relationships: { gameCenterAchievement: { data: { type: "gameCenterAchievements", id: a_id } } } } })["data"]
        end
        loc_id = loc["id"]
        img = begin
          asc_call(:get, "gameCenterAchievementLocalizations/#{loc_id}/gameCenterAchievementImage")["data"]
        rescue StandardError
          nil
        end
        path = File.expand_path("../docs/gamecenter/achievement-#{slug}.png", __dir__)
        bytes = File.binread(path)
        if img.nil?
          img = asc_call(:post, "gameCenterAchievementImages", { data: { type: "gameCenterAchievementImages",
            attributes: { fileName: File.basename(path), fileSize: bytes.bytesize },
            relationships: { gameCenterAchievementLocalization: { data: { type: "gameCenterAchievementLocalizations", id: loc_id } } } } })["data"]
          img["attributes"]["uploadOperations"].to_a.each do |op|
            uri = URI(op["url"])
            req = Net::HTTP.const_get(op["method"].to_s.capitalize).new(uri)
            op["requestHeaders"].to_a.each { |h| req[h["name"]] = h["value"] }
            req.body = bytes.byteslice(op["offset"], op["length"])
            res = Net::HTTP.start(uri.host, uri.port, use_ssl: true) { |http| http.request(req) }
            UI.user_error!("image upload failed (#{res.code})") unless res.code.to_i.between?(200, 299)
          end
        end
        state = img.dig("attributes", "assetDeliveryState", "state").to_s
        if state == "AWAITING_UPLOAD" || state.empty?
          asc_call(:patch, "gameCenterAchievementImages/#{img['id']}", { data: { type: "gameCenterAchievementImages", id: img["id"], attributes: { uploaded: true } } })
          UI.success("committed image #{vid}")
        else
          UI.message("image state for #{vid}: #{state}")
        end
      rescue StandardError => e
        failures << "#{vid}: #{e.message.to_s[0, 400]}"
        UI.error("FAILED #{vid}: #{e.message.to_s[0, 400]}")
      end
    end
    UI.user_error!("Game Center had #{failures.length} failure(s):\n" + failures.join("\n")) unless failures.empty?
    UI.success("Game Center: 21 leaderboards + 4 achievements present")
  end

  # ---------------------------------------------------------------------------------------------
  # testflight_internal: creates an internal TestFlight group "Internal" (ASC users only, no beta review), adds the
  # account holder's App Store Connect user as the only tester and gives the group the uploaded build(s).
  # The repo is public, so the tester's email is masked in logs.
  # ---------------------------------------------------------------------------------------------
  desc "Create internal beta group + account holder tester so Apple emails the TestFlight invite (idempotent)"
  lane :testflight_internal do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No App Store Connect app record for #{BUNDLE_ID}") if app.nil?
    mask = lambda { |e| e.to_s.sub(/\A(.{2}).*(@.*)\z/, '\1***\2') }

    users = asc_call(:get, "users", nil, { limit: 200 })["data"].to_a
    UI.message("ASC users: " + users.map { |u| "#{mask.call(u.dig('attributes', 'username'))} roles=#{u.dig('attributes', 'roles').to_a.join('/')}" }.join(" | "))
    holder = users.find { |u| u.dig("attributes", "roles").to_a.include?("ACCOUNT_HOLDER") }
    holder ||= users.first if users.length == 1
    UI.user_error!("Could not identify the account holder among #{users.length} users") if holder.nil?
    email = holder.dig("attributes", "username").to_s
    first = holder.dig("attributes", "firstName").to_s
    last = holder.dig("attributes", "lastName").to_s
    UI.important("Account holder: #{first} #{last} <#{mask.call(email)}> roles=#{holder.dig('attributes', 'roles').to_a.join('/')}")

    groups = asc_call(:get, "apps/#{app.id}/betaGroups", nil, { limit: 200 })["data"].to_a
    UI.message("existing beta groups: " + groups.map { |g| "#{g.dig('attributes', 'name')} internal=#{g.dig('attributes', 'isInternalGroup')}" }.join(", "))
    group = groups.find { |g| g.dig("attributes", "isInternalGroup") == true && g.dig("attributes", "name") == "Internal" }
    if group.nil?
      group = asc_call(:post, "betaGroups", { data: { type: "betaGroups",
        attributes: { name: "Internal", isInternalGroup: true, hasAccessToAllBuilds: true, publicLinkEnabled: false },
        relationships: { app: { data: { type: "apps", id: app.id } } } } })["data"]
      UI.success("created internal beta group #{group['id']}")
    else
      UI.message("internal beta group exists: #{group['id']}")
    end
    gid = group["id"]

    # How Blackspire is set up (read-only): its beta groups and their testers
    bs = Spaceship::ConnectAPI::App.find("com.gorillastocks.blackspire")
    if bs
      asc_call(:get, "apps/#{bs.id}/betaGroups", nil, { limit: 50 })["data"].to_a.each do |g|
        ts = asc_call(:get, "betaGroups/#{g['id']}/betaTesters", nil, { limit: 50 })["data"].to_a
        UI.important("Blackspire group '#{g.dig('attributes', 'name')}' internal=#{g.dig('attributes', 'isInternalGroup')} allBuilds=#{g.dig('attributes', 'hasAccessToAllBuilds')} testers=" +
                     ts.map { |t| "#{mask.call(t.dig('attributes', 'email'))}(#{t.dig('attributes', 'state')}/#{t.dig('attributes', 'inviteType')})" }.join(","))
      end
    end

    existing = asc_call(:get, "betaGroups/#{gid}/betaTesters", nil, { limit: 200 })["data"].to_a
    tester = existing.find { |t| t.dig("attributes", "email").to_s.downcase == email.downcase }
    if tester.nil?
      found = asc_call(:get, "betaTesters", nil, { "filter[email]" => email })["data"].to_a.first
      if found
        UI.important("existing tester record id=#{found['id']} state=#{found.dig('attributes', 'state')} inviteType=#{found.dig('attributes', 'inviteType')}")
        begin
          gs = asc_call(:get, "betaTesters/#{found['id']}/betaGroups", nil, { limit: 50 })["data"].to_a
          UI.important("tester is in groups: " + gs.map { |g| "#{g.dig('attributes', 'name')} internal=#{g.dig('attributes', 'isInternalGroup')}" }.join(", "))
        rescue StandardError => e
          UI.message("tester groups: #{e.message.to_s[0, 200]}")
        end
        begin
          asc_call(:post, "betaGroups/#{gid}/relationships/betaTesters", { data: [{ type: "betaTesters", id: found["id"] }] })
          tester = found
          UI.success("added existing beta tester record to the group")
        rescue StandardError => e
          UI.important("relationship add failed: #{e.message.to_s[0, 300]}")
          begin
            asc_call(:post, "betaTesters", { data: { type: "betaTesters",
              attributes: { email: email, firstName: first, lastName: last },
              relationships: { betaGroups: { data: [{ type: "betaGroups", id: gid }] } } } })
            tester = found
            UI.success("create-with-group succeeded")
          rescue StandardError => e2
            UI.important("create-with-group failed: #{e2.message.to_s[0, 300]}")
          end
        end
      else
        tester = asc_call(:post, "betaTesters", { data: { type: "betaTesters",
          attributes: { email: email, firstName: first, lastName: last },
          relationships: { betaGroups: { data: [{ type: "betaGroups", id: gid }] } } } })["data"]
        UI.success("created beta tester and added to group")
      end
    else
      UI.message("tester already in the group")
    end
    if tester
      t = asc_call(:get, "betaTesters/#{tester['id']}")["data"]
      UI.important("tester state=#{t.dig('attributes', 'state')} inviteType=#{t.dig('attributes', 'inviteType')}")
    end

    # builds: hasAccessToAllBuilds should cover it; also attach explicitly and report each build
    builds = app.get_builds(limit: 10, sort: "-uploadedDate")
    builds.each do |b|
      next unless b.processing_state == "VALID"
      begin
        asc_call(:post, "betaGroups/#{gid}/relationships/builds", { data: [{ type: "builds", id: b.id }] })
        UI.success("attached build #{b.version}")
      rescue StandardError => e
        UI.message("attach build #{b.version}: #{e.message.to_s[0, 200]}")
      end
    end
    gb = asc_call(:get, "betaGroups/#{gid}/builds", nil, { limit: 20 })["data"].to_a
    UI.important("builds visible to the group: " + gb.map { |b| "id=#{b['id']} version=#{b.dig('attributes', 'version')} state=#{b.dig('attributes', 'processingState')}" }.join(", "))
    builds.first(3).each do |b|
      begin
        d = asc_call(:get, "builds/#{b.id}/buildBetaDetail")["data"]
        UI.important("build #{b.version} internalBuildState=#{d.dig('attributes', 'internalBuildState')} externalBuildState=#{d.dig('attributes', 'externalBuildState')} autoNotify=#{d.dig('attributes', 'autoNotifyEnabled')}")
      rescue StandardError => e
        UI.message("buildBetaDetail #{b.version}: #{e.message.to_s[0, 200]}")
      end
    end
  end

  desc "Send the TestFlight invitation email to the account holder's existing beta tester record (fail-soft, logs the API result)"
  lane :testflight_invite do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    holder = asc_call(:get, "users", nil, { limit: 200 })["data"].to_a.find { |u| u.dig("attributes", "roles").to_a.include?("ACCOUNT_HOLDER") }
    UI.user_error!("no account holder") if holder.nil?
    email = holder.dig("attributes", "username").to_s
    tester = asc_call(:get, "betaTesters", nil, { "filter[email]" => email })["data"].to_a.first
    UI.user_error!("no beta tester record") if tester.nil?
    begin
      r = asc_call(:post, "betaTesterInvitations", { data: { type: "betaTesterInvitations", relationships: {
        betaTester: { data: { type: "betaTesters", id: tester["id"] } }, app: { data: { type: "apps", id: app.id } } } } })
      UI.success("invitation created: #{r.dig('data', 'id')}")
    rescue StandardError => e
      UI.important("invitation API: #{e.message.to_s[0, 400]}")
    end
  end

  desc "Run fastlane/asc_script.rb (MODE env: inspect / prepare / submit) against App Store Connect"
  lane :asc_script do
    asc_api_key
    app = Spaceship::ConnectAPI::App.find(BUNDLE_ID)
    UI.user_error!("No ASC app") if app.nil?
    $asc_app_id = app.id
    sp = File.expand_path(ENV["MODE"].to_s.start_with?("v7_") ? "asc_v7.rb" : (ENV["MODE"] == "bs" ? "asc_bs.rb" : "asc_script.rb"), __dir__)
    eval(File.read(sp), binding, sp, 1)
  end

end
